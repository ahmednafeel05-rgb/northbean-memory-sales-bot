      "paths": [],
      "tags": []
    },
    {
      "id": "INVARIANT-d88b49e2",
      "text": "I2: Deleted memories never retrieved; content/embedding nulled immediately",
      "source": "docs/DESIGN_BRIEF.md §10",
      "recorded_at": "2026-10-23T05:44:00.164Z",
      "paths": [],
      "tags": []
    },
    {
      "id": "INVARIANT-576fc886",
      "text": "I3: Memory-layer failure never blocks a chat reply",
      "source": "docs/DESIGN_BRIEF.md §10",
      "recorded_at": "2026-10-23T05:44:00.752Z",
      "paths": [],
      "tags": []
    },
    {
      "id": "INVARIANT-4694157e",
      "text": "I4: Every active memory carries non-null provenance/source",
      "source": "docs/DESIGN_BRIEF.md §10",
      "recorded_at": "2026-10-23T05:44:01.524Z",
      "paths": [],
      "tags": []
    },
    {
      "id": "INVARIANT-0e248126",
      "text": "I5: No invented products, prices, or discounts; discount never exceeds cap",
      "source": "docs/DESIGN_BRIEF.md §10",
      "recorded_at": "2026-10-23T05:44:02.144Z",
      "paths": [],
      "tags": []
    },
    {
      "id": "INVARIANT-2e63f7f3",
      "text": "I6: No personalisation consent -> zero memory rows stored",
      "source": "docs/DESIGN_BRIEF.md §10",
      "recorded_at": "2026-10-23T05:44:02.770Z",
      "paths": [],
      "tags": []
    },
    {
      "id": "INVARIANT-1a5a40f8",
      "text": "I7: No C3 PII (cards, passwords, addresses, phones, emails, IDs) ever stored in memories or audit log",
      "source": "docs/DESIGN_BRIEF.md §10",
      "recorded_at": "2026-10-23T05:44:03.481Z",
      "paths": [],
      "tags": []
    }
  ],
  "decisions": [
    {
      "id": "DECISION-fcfb7398",
      "title": "Stack",
      "text": "Next.js frontend, FastAPI backend, PostgreSQL+pgvector, LiteLLM (Gemini/Groq), Presidio for PII, Docker Compose. One backend service, solo builder.",
      "status": "accepted",
      "source": "docs/DESIGN_BRIEF.md §17",
      "recorded_at": "2026-10-23T05:44:12.957Z",
      "paths": [],
      "tags": []
    },
    {
      "id": "DECISION-78e5f19c",
      "title": "Identity model",
      "text": "Logged-in customers only (simple login/user switcher: Maya, Leo, Ana, Sam). Every memory keyed to customer_id; no anonymous merge.",
      "status": "accepted",
      "source": "docs/DESIGN_BRIEF.md §0",
      "recorded_at": "2026-10-23T05:44:13.511Z",
      "paths": [],
      "tags": []
    },
    {
      "id": "DECISION-acd25f2b",
      "title": "LLM provider",
      "text": "Free tier only: Gemini/Groq via LiteLLM, with retry/backoff and fallback provider. Synthetic data only, since free tiers may train on prompts.",
      "status": "accepted",
      "source": "docs/DESIGN_BRIEF.md §0",
      "recorded_at": "2026-10-23T05:44:14.199Z",
      "paths": [],
      "tags": []
    },
    {
      "id": "DECISION-c8944d71",
      "title": "Region and governance",
      "text": "US + EU, GDPR-first demo-level governance: consent, access, export, correct, delete, retention built in from v1.",
      "status": "accepted",
      "source": "docs/DESIGN_BRIEF.md §0",
      "recorded_at": "2026-10-23T05:44:14.747Z",
      "paths": [],
      "tags": []
    },
    {
      "id": "DECISION-5b3959ac",
      "title": "Open decisions defaults",
      "text": "Discount: 10% first-order code, once per customer. Retention: messages 90 days, archived memories 12 months. Human handoff: mock support inbox page. Brand: Northbean Coffee. These defaults apply unless Naf changes them.",
      "status": "accepted",
      "source": "docs/DESIGN_BRIEF.md §15",
      "recorded_at": "2026-10-23T05:44:15.363Z",
      "paths": [],
      "tags": []
    },
    {
      "id": "DECISION-b41cf85d",
      "title": "Embedding model pinned (ADR-003)",
      "text": "Gemini text-embedding-004, 768 dimensions. memories.embedding is vector(768) in db/schema.sql. Changing later requires a migration + re-embed script.",
      "status": "accepted",
      "source": "adr/003-embedding-model.md",
      "recorded_at": "2026-10-23T06:59:34.699Z",
      "paths": [],
      "tags": []
    },
    {
      "id": "DECISION-1f3e53ee",
      "title": "Postgres + pgvector, one database (ADR-001)",
      "text": "One PostgreSQL (pgvector/pgvector:pg16) holds relational tables and memories.embedding; hybrid retrieval (HNSW + GIN tsvector) runs in SQL, no separate vector DB.",
      "status": "accepted",
      "source": "adr/001-postgres-pgvector.md",
      "recorded_at": "2026-10-23T06:59:35.591Z",
      "paths": [],
      "tags": []
    }
  ],
